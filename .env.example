# ========== Required ==========
MONGO_URL=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=inked
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Public URL of this backend (Cloud Run URL or custom domain). Used for redirects/callbacks.
APP_URL=https://your-service-xxxxx-as.a.run.app
# BACKEND_PUBLIC_URL=   # optional alias

# ========== Admin bootstrap (recommended) ==========
INKED_ADMIN_EMAIL=admin@yourdomain.com
INKED_ADMIN_PASSWORD=strong-password-here
INKED_ADMIN_NAME=TINTA Admin

# ========== Business ==========
INKED_COMMISSION_PERCENT=15

# ========== Payments ==========
# Keep false in production. When true, references starting with TEST-GCASH- are accepted as test payments.
TEST_PAYMENT_MODE=false

# Optional – only if you later enable Stripe
# STRIPE_API_KEY=sk_live_...

# ========== Object Storage / Emergent (if used) ==========
# INTEGRATION_PROXY_URL=
# EMERGENT_LLM_KEY=

# ========== Frontend (Expo) ==========
# Set these in frontend/.env or EAS / build secrets
# EXPO_PUBLIC_API_URL=https://your-service-xxxxx-as.a.run.app
